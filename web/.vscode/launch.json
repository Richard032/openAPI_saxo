{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Saxo application server",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "C:/Program Files/Microsoft Visual Studio/18/Professional/MSBuild/Microsoft/VisualStudio/NodeJs/node.exe",
      "runtimeArgs": ["--import", "tsx"],
      "program": "${workspaceFolder}/src/server.ts",
      "sourceMaps": true
    },
    {
      "name": "Saxo demo in Edge",
      "type": "edge",
      "request": "launch",
      "url": "http://localhost:3000/",
      "webRoot": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "Saxo demo: server + browser",
      "configurations": [
        "Saxo application server",
        "Saxo demo in Edge"
      ],
      "stopAll": true
    }
  ]
}
