{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Saxo API server",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "C:/Program Files/Microsoft Visual Studio/18/Professional/MSBuild/Microsoft/VisualStudio/NodeJs/node.exe",
      "runtimeArgs": ["--import", "tsx"],
      "program": "${workspaceFolder}/src/server.ts",
      "sourceMaps": true
    },
    {
      "name": "React development server",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "C:/Program Files/Microsoft Visual Studio/18/Professional/MSBuild/Microsoft/VisualStudio/NodeJs/node.exe",
      "program": "${workspaceFolder}/node_modules/vite/bin/vite.js",
      "args": ["--host", "localhost"]
    },
    {
      "name": "Saxo demo in Edge",
      "type": "edge",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/client"
    }
  ],
  "compounds": [
    {
      "name": "Saxo demo: server + browser",
      "configurations": [
        "Saxo API server",
        "React development server",
        "Saxo demo in Edge"
      ],
      "stopAll": true
    }
  ]
}
