{
  "name": "saxo-demo-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:server": "tsx watch src/server.ts",
    "dev:client": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && vite build",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@types/express": "^5.0.3",
    "@types/node": "^22.13.10",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^6.3.5"
  }
}
